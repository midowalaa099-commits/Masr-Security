<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="MASR_POSTGRES_TESTS" value="1"/>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-pgsql-config.php"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_DATABASE" value="masr_security_test"/>
        <server name="DB_URL" value=""/>
        <server name="DATABASE_URL" value=""/>
        <server name="DB_HOST" value="127.0.0.1"/>
        <server name="DB_PORT" value="54329"/>
        <server name="DB_USERNAME" value="masr_test"/>
        <server name="DB_PASSWORD" value=""/>
        <server name="DB_SSLMODE" value="disable"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-pgsql-config.php" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="masr_security_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DATABASE_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="54329" force="true"/>
        <env name="DB_USERNAME" value="masr_test" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_SSLMODE" value="disable" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PAYMOB_SANDBOX_MODE" value="true" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
