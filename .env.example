APP_NAME="MASR Security"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
#
# This project is developed against MySQL. Tests automatically switch to an
# in-memory SQLite database (see phpunit.xml), so no local SQLite file is
# needed for `php artisan test`.
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masr_security
DB_USERNAME=root
DB_PASSWORD=

# Optional: use SQLite for lightweight local runs:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# ---------------------------------------------------------------------------
# Session / Cache / Queue (database-backed by default)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@masr-security.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Object storage (optional — product images default to the local `public` disk)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Admin bootstrap user (used by the AdminSeeder, not your real credentials).
# ADMIN_PASSWORD must be a strong secret; leave it empty to have a one-time
# password generated (and printed) on development builds.
# ---------------------------------------------------------------------------
ADMIN_NAME="MASR Admin"
ADMIN_EMAIL=admin@masr-security.com
ADMIN_PASSWORD=
ADMIN_PHONE="+20 100 000 0000"

# ---------------------------------------------------------------------------
# Paymob
# ---------------------------------------------------------------------------
#
# When the secret/public keys are empty (or PAYMOB_SANDBOX_MODE=true) the
# gateway falls back to a local sandbox that simulates the callbacks — the
# order flow stays fully testable without real credentials.
#
# Real integration ids come from your Paymob dashboard (PayMob Integration).
# HMAC secret is the one you set on the callback/notification URL.
#
PAYMOB_API_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_API_KEY=
PAYMOB_CARD_INTEGRATION_ID=0
PAYMOB_WALLET_INTEGRATION_ID=0
PAYMOB_HMAC_SECRET=
PAYMOB_EXPIRATION=3600
PAYMOB_SANDBOX_MODE=false

VITE_APP_NAME="${APP_NAME}"
